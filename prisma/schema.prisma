generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  homeCurrency  String         @default("PHP")
  accounts      Account[]
  sessions      Session[]
  trips         TripMember[]
  paid          Expense[]      @relation("Payer")
  splits        ExpenseSplit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id        String   @id @default(cuid())
  tripId    String
  email     String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
}

model Trip {
  id           String        @id @default(cuid())
  title        String
  destination  String
  country      String?
  startDate    DateTime
  endDate      DateTime
  budgetCents  Int           @default(0)
  currency     String        @default("PHP")
  coverUrl     String?
  members      TripMember[]
  activities   Activity[]
  places       Place[]
  reservations Reservation[]
  invites      Invite[]
  expenses     Expense[]
}

model TripMember {
  tripId String
  userId String
  role   String @default("TRAVELER")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([tripId, userId])
}

model Place {
  id         String     @id @default(cuid())
  tripId     String
  name       String
  category   String
  lat        Float
  lng        Float
  imageUrl   String?
  saved      Boolean    @default(true)
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]
}

model Activity {
  id             String   @id @default(cuid())
  tripId         String
  placeId        String?
  day            Int
  startsAt       String?
  title          String
  estimatedCents Int      @default(0)
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place          Place?   @relation(fields: [placeId], references: [id])
  expenses       Expense[]
}


model Reservation {
  id        String    @id @default(cuid())
  tripId    String
  kind      String
  title     String
  reference String?
  status    String    @default("BOOKED")
  details   String?
  date      DateTime?
  costCents Int       @default(0)
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String         @id @default(cuid())
  tripId      String
  activityId  String?
  payerId     String
  title       String
  category    String
  amountCents Int
  spentOn     DateTime
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity    Activity?      @relation(fields: [activityId], references: [id])
  payer       User           @relation("Payer", fields: [payerId], references: [id])
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  expenseId   String
  userId      String
  shareCents  Int
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id])
  @@id([expenseId, userId])
}
